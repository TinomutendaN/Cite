# Copy to .env and fill in. Never commit .env.

# --- Database (local Docker Compose) ---
POSTGRES_USER=cite
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cite
# api: used outside Compose (e.g. running ingest from your laptop).
# Compose overrides this to point at the db service.
DATABASE_URL=postgresql://cite:change-me@localhost:5433/cite
# Production (Vercel api project): Neon's POOLED connection string, e.g.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# --- Documents (api) ---
# Folder with the sample PDFs. Leave unset: it defaults to data/documents in a
# checkout and /data/documents inside the api container.
# DOCUMENTS_DIR=

# --- Model providers (api only, never exposed to the browser) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# api: Ollama's OpenAI-compatible endpoint (local video demo only). Leave it
# unset on Vercel: without it, a stored "ollama" choice falls back to DEFAULT_PROVIDER.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# --- Models (api) ---
# One embedding model for everything; stored vectors only work with the model that made them.
EMBEDDING_MODEL=text-embedding-3-small
# Prices for these are in api/app/config.py (PRICES_PER_MTOK).
OPENAI_MODEL=gpt-6-luna
ANTHROPIC_MODEL=claude-haiku-5-5
OLLAMA_MODEL=llama3.1
# api: provider used until one is chosen on the Admin page (openai | anthropic | ollama).
DEFAULT_PROVIDER=openai

# --- Limits (api) ---
# Free questions per visitor per day (shown on the Ask page).
VISITOR_DAILY_LIMIT=10
# Total questions per day across the whole demo (shown on the Admin page).
DAILY_QUESTION_CAP=500
# api: secret salt for hashing visitor IPs before they are stored.
VISITOR_HASH_SALT=

# --- Answers (api) ---
# With no keyword match, questions whose closest passage is below this cosine
# similarity get "couldn't find this" without calling the model.
# Tune with: docker compose exec api python -m app.check --no-model
RAG_MIN_SIMILARITY=0.25

# --- Frontend (web) ---
# Server-only (not NEXT_PUBLIC_). Where the /api rewrite forwards requests.
# Defaults to http://localhost:8000 in development; required in production
# (the api Vercel project's URL, e.g. https://cite-api.vercel.app).
API_URL=
